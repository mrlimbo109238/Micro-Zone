################################################################################
## Micro Zone - Персонажи
################################################################################
## Здесь объявляются все персонажи игры. Формат:
##
##   define <короткое_имя> = Character("Отображаемое имя", color="#цвет")
##
## Потом в script.rpy пишешь диалог так:
##
##   limbo "Привет, это моя реплика!"
##
## Цвет — в формате HTML (#ffffff = белый, #ff0000 = красный).
################################################################################

## Главный герой / рассказчик (без имени над репликой).
define narrator = Character(None, what_italic=True)

## Пример: замени/дополни своими персонажами.
define limbo = Character("Limbo", color="#4FC3F7")

## Когда будешь готов — добавь остальных, например:
## define alex = Character("Алекс", color="#FFB74D")
## define nina = Character("Нина", color="#F06292")

## Безымянный голос "за кадром" (например, мысли героя).
define thoughts = Character(None, what_italic=True, what_color="#888888")
