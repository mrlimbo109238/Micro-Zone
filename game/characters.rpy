################################################################################
## Micro Zone — Персонажи
################################################################################
## Объявления персонажей. Чтобы добавить нового — скопируй строку
## define ... = Character(...) и поменяй имя/цвет.
################################################################################

## Главный герой — подросток Саша. От его лица идёт повествование.
define s = Character("Саша", color="#4FC3F7")

## Родители Саши.
define m = Character("Мама", color="#F48FB1")
define p = Character("Папа", color="#90CAF9")

## Аня — таинственная девочка, которую Саша находит в запертой комнате.
define a = Character("Аня", color="#CE93D8")

## Валентин — сосед, рассказывающий мрачную историю дома.
define v = Character("Валентин", color="#BCAAA4")

## Безымянная подача — описания, атмосфера, действия.
## Используется как:  "просто текст в кавычках"
define narrator = Character(None, what_italic=True)

## Внутренние мысли героя (на случай если захотим стилистически выделить).
define thoughts = Character(None, what_italic=True, what_color="#B0BEC5")
