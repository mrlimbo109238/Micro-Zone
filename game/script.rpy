################################################################################
## Micro Zone — Главный сценарий
################################################################################
## Здесь живёт сюжет игры. Каждая сцена — это блок текста и реплик.
##
## Шпаргалка для быстрого редактирования:
##   scene bg1                  -> показать фон 1-й сцены
##   s "Реплика"                -> Саша говорит
##   m "Реплика"                -> Мама говорит
##   p "Реплика"                -> Папа говорит
##   "Просто текст"             -> описание / атмосфера / действия (без имени)
##   with fade                  -> плавный переход
##   pause 1.0                  -> пауза 1 секунда
##   play music "файл.mp3"      -> включить музыку
##   stop music fadeout 1.0     -> выключить музыку
################################################################################


################################################################################
## ПЕРСИСТЕНТНЫЕ НАСТРОЙКИ (хранятся между запусками игры)
################################################################################

## Показывать ли вступительные экраны при старте новой игры.
## Игрок может выключить их в настройках.
default persistent.show_intro = True

## Цензура матов в диалогах. Включается автоматически, если игрок указал,
## что ему меньше 16 лет. Управляется в настройках.
default persistent.profanity_censor = False


################################################################################
## ФОНЫ
################################################################################
## Объявляем фоновые картинки. Файлы лежат в game/images/.
## Картинки масштабируем до размера игры (1920x1080), чтобы они
## заполняли экран целиком.

## Глава 1.
image bg1 = Transform("bg_scene_01.png", size=(1920, 1080))
image bg2 = Transform("bg_scene_02.png", size=(1920, 1080))
image bg3 = Transform("bg_scene_03.png", size=(1920, 1080))
image bg4 = Transform("bg_scene_04.png", size=(1920, 1080))
image bg5 = Transform("bg_scene_05.png", size=(1920, 1080))

## Глава 2.
image bg6  = Transform("bg_scene_06.png",  size=(1920, 1080))
image bg7  = Transform("bg_scene_07.png",  size=(1920, 1080))
image bg8  = Transform("bg_scene_08.png",  size=(1920, 1080))
image bg8b = Transform("bg_scene_08b.png", size=(1920, 1080))
image bg9  = Transform("bg_scene_09.png",  size=(1920, 1080))
image bg10 = Transform("bg_scene_10.png",  size=(1920, 1080))
image bg11 = Transform("bg_scene_11.png",  size=(1920, 1080))
image bg12 = Transform("bg_scene_12.png",  size=(1920, 1080))

## Глава 3.
image bg13     = Transform("bg_scene_13.png",      size=(1920, 1080))
image bg14_15  = Transform("bg_scene_014-015.png", size=(1920, 1080))
image bg16     = Transform("bg_scene_16.png",      size=(1920, 1080))
image bg17     = Transform("bg_scene_17.png",      size=(1920, 1080))
image bg17b    = Transform("bg_scene_17b.png",     size=(1920, 1080))
image bg18     = Transform("bg_scene_18.png",      size=(1920, 1080))
image bg19     = Transform("bg_scene_19.png",      size=(1920, 1080))
image bg20     = Transform("bg_scene_20.png",      size=(1920, 1080))
image bg21     = Transform("bg_scene_21.png",      size=(1920, 1080))
image bg22     = Transform("bg_scene_22.png",      size=(1920, 1080))
image bg23     = Transform("bg_scene_23.png",      size=(1920, 1080))
image bg24     = Transform("bg_scene_24.png",      size=(1920, 1080))
image bg25     = Transform("bg_scene_25.png",      size=(1920, 1080))
image bg26     = Transform("bg_scene_26.png",      size=(1920, 1080))
image bg27     = Transform("bg_scene_27.png",      size=(1920, 1080))
image bg28     = Transform("bg_scene_28.png",      size=(1920, 1080))


################################################################################
## ТОЧКА ВХОДА
################################################################################

## Игра всегда начинается с метки "start".
label start:
    if persistent.show_intro:
        call intro_screens
    jump chapter_1


################################################################################
## ВСТУПИТЕЛЬНЫЕ ЭКРАНЫ
################################################################################
## 4 экрана подряд:
##   1. Сообщение «ты СОО-креатор»
##   2. Дисклеймер про реальные события
##   3. «Привет, я Лимба»
##   4. Вопрос про возраст (16+ / меньше 16) → выставляет цензуру.
##
## Каждый из первых 3 экранов закрывается тапом по экрану.
## Управляется через screen intro_message и screen intro_age_question
## из game/screens.rpy.

label intro_screens:

    ## Прячем quick_menu (нижнюю панель) на время интро.
    $ quick_menu = False

    scene black
    with fade

    call screen intro_message(message=_(
        "Привет!\n\n"
        "Ты являешься {color=#CE93D8}{b}СОО-креатором{/b}{/color} этой игры.\n\n"
        "Добро пожаловать в Micro Zone — надеюсь, она тебе понравится "
        "хотя бы сюжетом ;)"
    ))

    call screen intro_message(message=_(
        "{color=#ff6b6b}{b}ВНИМАНИЕ!{/b}{/color}\n\n"
        "Игра создана {b}не{/b} на реальных событиях.\n\n"
        "Если что-то из увиденного напомнит вам ваш личный опыт "
        "или детскую травму — рекомендуем обратиться к психологу.\n\n"
        "{color=#ff6b6b}{b}Слабонервным играть не советуем.{/b}{/color}"
    ))

    call screen intro_message(message=_(
        "Привет, я {color=#CE93D8}{b}Лимба{/b}{/color}.\n\n"
        "Я очень рад, что ты зашёл поиграть в мою игру.\n\n"
        "Спасибо тебе огромное <3"
    ))

    ## Вопрос про возраст. Возвращает True, если игроку меньше 16.
    call screen intro_age_question
    $ persistent.profanity_censor = bool(_return)

    if persistent.profanity_censor:
        call screen intro_message(message=_(
            "Так как тебе ещё нет 16, мы скрыли всю нецензурную лексику в диалогах.\n\n"
            "Это можно изменить в любой момент в {color=#CE93D8}настройках{/color}."
        ))

    scene black
    with fade

    ## Возвращаем quick_menu для основной игры.
    $ quick_menu = True

    return


################################################################################
## ГЛАВА 1
################################################################################
label chapter_1:

    # ---- Заставка главы --------------------------------------------------
    scene black
    with fade
    pause 0.5

    centered "{size=72}Глава 1{/size}"
    pause 0.5

    # ---- СЦЕНА 1.1 — машина в лесу ---------------------------------------
    # Музыка led_pol — фоновый саундтрек на сцены 1-2.
    # Звук двигателя (зацикленный) — сразу со старта сцены, до конца сцены.
    play music "audio/music/led_pol.mp3" fadein 2.0
    play amb_engine "audio/sfx/engine01.mp3" fadein 1.5

    scene bg1
    with fade

    "За окном машины тянулся бесконечный, мрачный лес."
    "Густой туман медленно стелился по низинам, почти касаясь колёс."
    "Редкие дорожные столбы с мерцающими, умирающими фонарями выхватывали из тьмы кривые ветки деревьев."
    "В салоне стоял пронизывающий холод, а давящая темнота снаружи казалась почти осязаемой."
    "Для полной картины безысходности не хватало только моросящего, ледяного дождя."

    m "Сегодня что-то совсем похолодало. Вить, закрой окно и включи печку."
    p "Угу..."

    # После 2-го диалога включается печка (зацикленная) — играет до
    # конца сцены параллельно с двигателем.
    play amb_stove "audio/sfx/stove01.mp3" fadein 1.5

    m "Вить, по времени мы должны быть уже на месте. Где мы блуждаем?"

    # Перед 4-м диалогом — однократный «маршрут перестроен» от навигатора.
    play sfx_navigator "audio/sfx/navigator01.mp3"

    p "Надь, ну где-то тут должно быть... Совсем немного осталось, наверное. Навигатор что-то тупит, связь теряет."
    s "Значит, мы ещё не скоро приедем?"
    m "Саш, ну не знаю я. Едем пока."
    s "Мам, я вообще-то в туалет хочу."
    m "Ну, даже если мы и приедем прямо сейчас, не факт, что там сразу будет нормальный туалет. Потерпи."
    s "Да капец просто!"
    s "Тут ещё и инета нет! Вы издеваетесь?! Мы едем в какую-то глухую деревню, в старую халупу, да ещё и без интернета! Супер, отлично заживём!"
    m "А ты не расслабляйся. У нас там огород непаханый, да и на подработку каждое утро будешь ходить — я уже с соседями договорилась!"
    s "Но... мам!"

    # ---- СЦЕНА 1.2 — приехали к дому --------------------------------------
    # Двигатель и печка плавно затихают (приехали и заглушили).
    # Музыка led_pol продолжается. Включается ветер на улице.
    stop amb_engine fadeout 1.5
    stop amb_stove fadeout 1.5
    play amb_wind "audio/sfx/wind02.mp3" fadein 1.5

    scene bg2
    with fade

    "Машина остановилась."
    "Сквозь редеющий туман проступил силуэт массивного деревянного дома."
    "Покосившийся забор, облупившаяся краска на досках и тёмные, словно пустые глазницы, окна не вызывали ни малейшего чувства уюта."
    "Дом казался не просто старым, а давно покинутым и враждебным."
    "Холодный ветер гулял по заросшему двору, тоскливо скрипя ржавыми петлями калитки."

    p "Это точно наш дом?"
    m "Ну да. Немного потрепанный, конечно, но мы его считай за полцены взяли..."

    "Её голос на секунду становится задумчивым."

    # Перед 3-м диалогом — однократный звук закрывающейся дверцы машины.
    play sfx_door "audio/sfx/car_door02.mp3"

    m "Хотя... странно, что они так быстро согласились его отдать."

    "Папа выходит из машины и кутается в куртку."

    p "Бр-р-р... Ну и холодина сегодня, аж до костей пробирает."

    "Саша выходит следом, поёживаясь, и молча смотрит на мрачный фасад."

    s "..."

    m "Так, Саш, давай бери эти сумки и заноси всё в дом. А мы с папой пока за остальными вещами съездим."

    "Саша округляет глаза от удивления и страха."

    s "Да вы шутите! Мне тут оставаться?! Здесь же жутко, тем более одному..."
    p "Хватит ныть. Ну ты и баба."

    "Саша возмущённо и обиженно сверлит отца взглядом, но тот лишь отмахивается."
    "Ощущение ледяной тревоги накрывает с головой."
    "Огромный, тёмный дом возвышается над ним, словно монстр, ожидающий, когда жертва сама переступит порог."
    "Тишина вокруг кажется абсолютно неестественной — ни лая собак, ни пения птиц."
    "Только свист ветра и удаляющийся шум родительской машины, оставляющей его один на один с этой пугающей неизвестностью."

    # ---- СЦЕНА 1.3 — внутри дома, картина --------------------------------
    # Кросс-фейд саундтрека: led_pol → scary_look (сцены 3-4).
    # Ветер продолжает играть — он же на улице звучит ещё в сценах 3 и 4.
    # Добавляется зацикленный скрип старого пола.
    play music "audio/music/scary_look.mp3" fadeout 2.0 fadein 2.0
    play amb_floor "audio/sfx/pol03.mp3" fadein 1.5

    scene bg3
    with fade

    "Я остался один."
    "Тяжёлая входная дверь захлопнулась за родителями, и тишина в доме сразу стала какой-то давящей, почти осязаемой."
    "Холодный ветер за окном завывал ещё громче, заставляя старые доски пола скрипеть под каждым моим осторожным шагом."
    "В тусклом коридоре царила полутьма. Всё вокруг казалось чужим и пугающим."

    "У подножия скрипучей лестницы, в массивной потемневшей рамке, висела картина. Я невольно остановился."
    "В тусклом свете из окна я разглядел мрачный, чёрно-белый рисунок, выполненный карандашом или тушью."
    "Это был лес, но не обычный. Стволы древних деревьев были чудовищно деформированы, неестественно скручены и переплетены, словно застывшие в вечных муках."
    "Плотная стена кривых ветвей создавала ощущение, будто они заперты в клетке."
    "На переднем плане, словно выползая из холста, клубилась жуткая сеть узловатых, сухих корней."
    "Они напоминали сплетённые в судороге кости, готовые схватить любого, кто подойдёт слишком близко."
    "Картина дышала древним, недобрым холодом."
    "Светлые пятна среди черноты казались пустыми глазницами, наблюдающими за мной из-за переплетения ветвей."
    "Я почувствовал, как по спине пробежал неприятный холодок."

    s "Странная картина... И почему она такая жуткая?"

    # ---- СЦЕНА 1.4 — звук из-за двери ------------------------------------
    # Скрип пола больше не нужен (дальше по сюжету его перебьёт грохот).
    # Ветер продолжается. Перед 1-м диалогом — однократный звук падения.
    stop amb_floor fadeout 1.5

    scene bg4
    with fade

    play sfx_noise "audio/sfx/noise03.mp3"

    s "А? Что за шум? Я же говорил, что этот дом конченный..."

    "Я замер, стараясь дышать как можно тише."
    "Звук доносился откуда-то спереди."
    "Осторожно ступая по скрипучим половицам, я прошёл чуть дальше по коридору."
    "Передо мной возникла массивная, неестественно широкая деревянная лестница, ведущая во мрак второго этажа."
    "Почти сразу слева от неё виднелась дверь. Темнота за ней казалась густой и непроницаемой, но интуиция подсказывала — звук донёсся именно оттуда."

    # Перед 2-м диалогом — однократный жуткий крик.
    play sfx_scream "audio/sfx/scary_scream.mp3"

    s "А-а-а! Что у вас тут происходит?!"

    "Я отшатнулся назад, едва не запнувшись о собственные ноги."
    "Сердце бешено заколотилось где-то в горле, а ладони мгновенно покрылись холодным потом."
    "В приоткрытой щели за дверью что-то с оглушительным грохотом рухнуло на пол, подняв облако вековой пыли."
    "Животный страх сковал тело, заставляя забыть обо всех логических доводах."
    "В этот момент хотелось только одного — развернуться и бежать из этого дома не оглядываясь."

    # ---- СЦЕНА 1.5 — у самой двери ---------------------------------------
    # Музыки в этой сцене больше нет (только сердцебиение через 5 секунд).
    # Ветер тоже затихает — Саша уже у двери, дальше — внутренний ужас.
    stop music fadeout 2.0
    stop amb_wind fadeout 1.5

    # Сердцебиение запускается через 5 секунд от начала сцены — таймером
    # из экрана sfx_heartbeat_delayed (см. screens.rpy).
    show screen sfx_heartbeat_delayed

    scene bg5
    with fade

    "Я стоял перед этой приоткрытой дверью, и мои ноги словно намертво приросли к старому скрипучему полу."
    "Тело напрочь отказывалось подчиняться."
    "Из узкой щели тянуло сыростью и каким-то мёртвым холодом, от которого по спине безостановочно бегали мурашки."
    "Сердце лупило по рёбрам так сильно и быстро, что пульс отдавался в ушах оглушительным набатом."
    "Я медленно протянул дрожащую руку к дверной ручке, но замер в миллиметре от неё."
    "Ладони мгновенно стали влажными от ледяного пота."

    # ---- Финал главы 1 ---------------------------------------------------
    # Глушим всё перед переходом к главе 2 — там пока тишина по просьбе Limbo.
    hide screen sfx_heartbeat_delayed
    stop amb_heartbeat fadeout 2.0

    scene black
    with fade
    pause 1.0

    jump chapter_2


################################################################################
## ГЛАВА 2
################################################################################
label chapter_2:

    scene black
    with fade
    pause 0.5

    centered "{size=72}Глава 2{/size}"
    pause 0.5

    # ---- СЦЕНА 2.1 — Саша встречает Аню ---------------------------------
    # Музыка full_bass — фоновый саундтрек на сцены 1-3.
    # Дверь открывается в самом начале сцены (однократный звук).
    play music "audio/music/full_bass.mp3" fadein 2.0
    play sfx_door "audio/music/door02.mp3"

    scene bg6
    with fade

    # Перед первой репликой Саши — звук удивления (он только что увидел Аню).
    play sfx_surprise "audio/music/surprise02.mp3"
    s "А-а-а! Т-ты кто?!"
    a "Привет..."
    s "..."
    a "Спасибо, что помог открыть дверь. Я... я не могла."
    s "Кто тебя запер?"
    a "Я не помню."
    s "А сидишь тут сколько? Тоже не помнишь?"
    a "Наверное, больше месяца..."
    s "А что с тобой произошло?!"
    a "Неважно..."
    s "Вообще-то важно! Это странно, что ты находишься в нашем новом доме, и мне нужна от тебя хоть какая-то информация!"
    a "Прости... Я просто не смогла найти себе дом. Я потеряла маму и папу..."
    s "Ладно... Подождём моих родителей, они скоро вернутся, и разберёмся, что нам с тобой делать."

    "Я внимательно оглядел её."
    "В полумраке комнаты стояла обычная девчонка, выглядевшая напуганной, замёрзшей и ужасно уставшей."
    "Мой первоначальный животный страх постепенно отступал, сменяясь глухим непониманием."
    "Весь этот абсурд не укладывался в голове: старый пугающий дом, запертая комната и эта странная незнакомка с такой тяжёлой историей."
    "Повисла долгая, неловкая пауза. Тишина нарушалась лишь завыванием ветра за окном."
    "Оставлять её здесь одну было как-то неправильно, да и мне самому было не по себе в этой гнетущей обстановке."

    s "Ладно, пошли вниз. Отвлечёмся от всего, что сейчас произошло..."
    a "Угу..."

    # ---- СЦЕНА 2.2 — спуск по лестнице ----------------------------------
    # Музыка full_bass продолжается. Включается ветер (зацикленный, до
    # конца главы) и скрип старого пола (только в этой сцене).
    play amb_wind "audio/sfx/wind02.mp3" fadein 1.5
    play amb_floor "audio/sfx/pol03.mp3" fadein 1.5

    scene bg7
    with fade

    "Мы вышли из комнаты в тёмный коридор."
    "Деревянные ступени широкой лестницы протяжно и угрожающе скрипели под нашими ногами, эхом отдаваясь в пустоте дома."
    "Аня шла впереди. Она двигалась осторожно, почти бесшумно, крепко сжимая руки."
    "Я спускался следом, внимательно глядя ей в спину."
    "Удивительно, но полумрак первого этажа казался уже не таким жутким, когда я был здесь не один."

    s "Ты иди, я сзади, не переживай."

    "Она едва заметно кивнула, не оборачиваясь, но я увидел, как её напряжённые плечи слегка расслабились. Мои слова подействовали."
    "С каждым шагом вниз липкий страх, который сковывал меня наверху, постепенно отступал."
    "Мы спустились в тускло освещённый холл."
