################################################################################
## Micro Zone - Главный сценарий
################################################################################
## Это главный файл игры. Здесь пишутся все сцены, диалоги и выборы.
##
## Быстрая шпаргалка:
##
##   scene bg_school            -> показать фон (файл game/images/bg_school.png)
##   show limbo_happy           -> показать спрайт персонажа
##   hide limbo_happy           -> убрать спрайт
##   play music "main_theme.ogg" -> включить музыку
##   stop music                 -> выключить музыку
##   play sound "door.ogg"      -> короткий звук
##   limbo "Реплика"            -> реплика персонажа (limbo определён в characters.rpy)
##   "Реплика без имени"        -> реплика рассказчика
##   jump chapter_2             -> перейти на метку "chapter_2"
##
## Выбор игрока:
##   menu:
##       "Вариант 1":
##           jump branch_1
##       "Вариант 2":
##           jump branch_2
##
## Полная документация: https://www.renpy.org/doc/html/quickstart.html
################################################################################


## Точка входа. Игра всегда начинается с метки "start".
label start:

    ## Пример стартового экрана — замени на свой первый фон.
    ## Файл должен лежать: game/images/bg_placeholder.png
    ## Если файла нет, Ren'Py покажет чёрный экран с сообщением.
    scene black

    "Добро пожаловать в Micro Zone."

    "Это шаблон первой сцены. Сюда ты (или я) вставим твои диалоги."

    limbo "Привет! Я Limbo, главный персонаж."

    limbo "Как только ты пришлёшь диалоги — заменим этот текст на настоящий сюжет."

    ## Пример выбора.
    menu:
        "Пройти к первой главе":
            jump chapter_1

        "Закончить демо":
            jump end_demo


label chapter_1:

    scene black
    with fade

    "Глава 1"

    "Здесь начнётся первая глава Micro Zone."

    jump end_demo


label end_demo:

    scene black
    with fade

    "Конец демо-версии."

    "Спасибо, что поиграл! Ждём продолжения от автора."

    return
